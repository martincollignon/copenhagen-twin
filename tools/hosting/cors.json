{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://martincollignon.github.io",
          "http://localhost:8000",
          "http://127.0.0.1:8000",
          "http://localhost:8080",
          "http://127.0.0.1:8080",
          "http://localhost:3000",
          "http://localhost:5173"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["Content-Length", "Content-Type", "ETag", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
